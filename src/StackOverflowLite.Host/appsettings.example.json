{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=your_db_name;Username=your_username;Password=your_password",
    "Redis": "localhost:6379"
  },
  "JwtSettings": {
    "Secret": "REPLACE_WITH_YOUR_SUPER_SECRET_KEY_MIN_32_CHARS",
    "Issuer": "StackOverflowLite",
    "Audience": "StackOverflowLite",
    "ExpiryMinutes": 1440
  }
}
